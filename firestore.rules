rules_version = '2';

// Règles de sécurité Bachata Fusion – Espace bénévoles.
// - Bénévoles : connexion anonyme, liée à un prénom via claims/{uid}.
//   Ils ne peuvent ajouter ou retirer QUE leur propre prénom d'un créneau, dans la limite des places.
// - Administrateur : connexion Google, UID du compte présent dans adminUids().
//   Pour ajouter un administrateur : ajouter son UID ici ET dans public/config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function adminUids() {
      return ['T3ZA4bGuNNQAwgQxK6RtAQbG1v82'];
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid in adminUids();
    }

    function myVolunteer() {
      return get(/databases/$(database)/documents/claims/$(request.auth.uid)).data.volunteerId;
    }

    function isActiveVolunteer(id) {
      let v = /databases/$(database)/documents/volunteers/$(id);
      return exists(v) && get(v).data.active == true;
    }

    function validSlot(data) {
      return data.keys().hasOnly(['position', 'label', 'start', 'end', 'capacity', 'volunteers'])
        && data.label is string && data.label.size() > 0 && data.label.size() <= 60
        && data.start is string && data.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.end is string && data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 20
        && data.volunteers is list && data.volunteers.size() <= data.capacity
        && data.volunteers.toSet().size() == data.volunteers.size();
    }

    // Un bénévole s'inscrit ou se désinscrit lui-même, sans toucher au reste du créneau.
    function isSelfToggle() {
      let me = myVolunteer();
      let before = resource.data.volunteers;
      let after = request.resource.data.volunteers;
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['volunteers'])
        && after.toSet().size() == after.size()
        && (
          (added.hasOnly([me]) && added.size() == 1 && removed.size() == 0
            && after.size() <= resource.data.capacity && isActiveVolunteer(me))
          ||
          (removed.hasOnly([me]) && removed.size() == 1 && added.size() == 0)
        );
    }

    match /volunteers/{volunteerId} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'active'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.active is bool;
    }

    match /claims/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['volunteerId'])
        && request.resource.data.volunteerId is string
        && isActiveVolunteer(request.resource.data.volunteerId);
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['type', 'typeName', 'title', 'date', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if isAdmin();

      match /slots/{slotId} {
        allow read: if signedIn();
        allow create: if isAdmin() && validSlot(request.resource.data);
        allow update: if isAdmin() && validSlot(request.resource.data);
        allow update: if signedIn() && isSelfToggle();
        allow delete: if isAdmin();
      }

      match /remarks/{remarkId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['volunteerId', 'text', 'createdAt'])
          && request.resource.data.volunteerId == myVolunteer()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin();
      }
    }
  }
}
